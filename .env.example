# Hana — environment variables (template)
# Copy to .env.local and fill in values for local dev.
# DO NOT commit .env or .env.local.
#
# 詳細セットアップ: docs/api-driven-development/db-setup.md

# === App ===
# Web Vitalsのcanonical Originにも使う。本番では未設定・不正値を503でfail closedする。
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# === Supabase: Database (Prisma) ===
# Settings → Database → Connection string
#   - URI (pgbouncer/pooler, port 6543) → DATABASE_URL
#   - Direct connection (port 5432)     → DIRECT_URL
DATABASE_URL=
DIRECT_URL=

# === Supabase: API ===
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# 物理削除workerは人間承認後にだけ `confirmed` を設定する。未設定はdry-run。
ACCOUNT_PHYSICAL_PURGE_APPLY=

# === Auth (Supabase Auth に統合。ローカル開発では基本不要) ===
# Supabase Auth が JWT を発行・検証するため、JWT_SECRET 等の自前管理は不要。
# Apple/Google OAuth プロバイダ設定は Supabase ダッシュボードで行う (ISSUE-006)。

# === Storage (Supabase Storage、ISSUE-008 で使用) ===
# Presigned URL TTL のみクライアントで上書き可能にしておく。
PRESIGNED_URL_TTL_SECONDS=1800

# === AI (ISSUE-010 で使用) ===
ANTHROPIC_API_KEY=
AI_MODEL=
AI_MAX_REGENERATE_PER_DAY=3

# === Observability ===
SENTRY_DSN=
LOG_LEVEL=info

# === Waitlist (公開前 LP) ===
# 待機リストの重複判定用 HMAC pepper。production では必須。
WAITLIST_EMAIL_HASH_PEPPER=
# プロダクトイベントの月次仮名化用 HMAC pepper。32文字以上をSecret Managerで管理する。
PRODUCT_EVENT_HASH_PEPPER=
# ISSUE-186のDB authority・retention検証後に保護Environmentから規定値を設定する。
PRODUCT_EVENT_INGEST_ACTIVATION=
# ISSUE-185の全key version退会purge・HMAC key lifecycle検証後に保護Environmentから規定値を設定する。
PRODUCT_EVENT_PURGE_ACTIVATION=
# GitHub Issue #384のstatus-only degradation ledger検証後に保護Environmentから規定値を設定する。3 activationが揃うまでingestは503で停止する。
PRODUCT_EVENT_DEGRADATION_ACTIVATION=
# ProductEvent actor HMACの保護version。`v1`形式で固定し、aggregate callerの入力を証跡へ転記しない。
TELEMETRY_ACTOR_KEY_VERSION=
# actor scope・query version・観測窓・eligible policy・sampling構成を観測開始前に署名するauthority key version。
TELEMETRY_AUTHORITY_KEY_VERSION=
# authority登録専用HMAC key。manifest commitment keyと分離し、32文字以上を保護Environmentで管理する。
TELEMETRY_AUTHORITY_COMMITMENT_KEY=
# 観測終了後に固定するevent universeの署名key version。
TELEMETRY_EVENT_UNIVERSE_KEY_VERSION=
# sealed event universe専用HMAC key。他のtelemetry keyと分離して保護Environmentで管理する。
TELEMETRY_EVENT_UNIVERSE_COMMITMENT_KEY=
# expectation manifestの署名key version。
TELEMETRY_MANIFEST_KEY_VERSION=
# expectation manifest専用HMAC key。aggregate callerへ渡さない。
TELEMETRY_MANIFEST_COMMITMENT_KEY=
# sampling keyのcommitment専用HMAC key。manifest、authority、registry、receipt keyと分離する。
TELEMETRY_SAMPLING_COMMITMENT_KEY=
# authority登録をwindow開始前に受理したappend-only registryのkey version。
TELEMETRY_AUTHORITY_REGISTRY_KEY_VERSION=
# authority registry receipt専用HMAC key。他のtelemetry keyと分離して保護Environmentで管理する。
TELEMETRY_AUTHORITY_REGISTRY_COMMITMENT_KEY=
# ingest receipt attestationのkey version。
TELEMETRY_INGEST_RECEIPT_KEY_VERSION=
# canonical envelope、authority context、DB由来received_atを署名するingest receipt専用HMAC key。
TELEMETRY_INGEST_RECEIPT_COMMITMENT_KEY=
# DB Memory exact-set receiptのkey version。
TELEMETRY_MEMORY_TRUTH_KEY_VERSION=
# M2 / M3 / M9のDB Memory truth専用HMAC key。
TELEMETRY_MEMORY_TRUTH_COMMITMENT_KEY=
# protected deploymentが配布する40桁Git commit SHA。caller payloadから受け取らない。
TELEMETRY_DEPLOYMENT_SHA=
# metric aggregate query専用key version。evidence signer keyや他のtelemetry keyと分離する。
TELEMETRY_METRIC_AGGREGATE_KEY_VERSION=
# eligible / success / censorとprivate truth commitmentのreceipt署名専用HMAC key。
TELEMETRY_METRIC_AGGREGATE_COMMITMENT_KEY=
# status-only evidenceのprivate commitment key version。
TELEMETRY_EVIDENCE_KEY_VERSION=
# private census / censoring / metric manifest専用HMAC key。通常callerへ渡さない。
TELEMETRY_EVIDENCE_COMMITMENT_KEY=
# M8 / M9のbaseline後target decision署名key version。
TELEMETRY_TARGET_DECISION_KEY_VERSION=
# M8 / M9 target decision専用HMAC key。他のtelemetry keyと分離する。
TELEMETRY_TARGET_DECISION_COMMITMENT_KEY=
# Web Vitalsのserver-side sampling用HMAC key。32文字以上をSecret Managerで管理する。
WEB_VITALS_SAMPLING_KEY=
# sampling decisionを期待manifestと結び付けるkey version。`none`は禁止。
WEB_VITALS_SAMPLING_KEY_VERSION=
# ISSUE-187の共有rate limit検証後に保護Environmentからtrueを設定する。
WEB_VITALS_SHARED_RATE_LIMIT_READY=false
# hosting proxyがforwarding headerを除去・上書きすると確認できた環境でだけtrue。
WEB_VITALS_TRUST_PROXY_HEADERS=false
# trusted edgeが付与するattestation secret。32文字以上をSecret Managerで管理する。
WEB_VITALS_EDGE_ATTESTATION_SECRET=
# hosting proxy が forwarding header を除去・上書きすると確認できた環境でだけ true。
WAITLIST_TRUST_PROXY_HEADERS=false
