# Hana — environment variables (template)
# Copy to .env.local and fill in values for local dev.
# DO NOT commit .env or .env.local.

# === App ===
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# === Auth ===
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# === OAuth (optional, MVP は email+password から開始) ===
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Database ===
DATABASE_URL=

# === Storage (Presigned URL) ===
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
PRESIGNED_URL_TTL_SECONDS=1800

# === AI ===
ANTHROPIC_API_KEY=
AI_MODEL=
AI_MAX_REGENERATE_PER_DAY=3

# === Observability ===
SENTRY_DSN=
LOG_LEVEL=info
