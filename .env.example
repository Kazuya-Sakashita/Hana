# Hana — environment variables (template)
# Copy to .env.local and fill in values for local dev.
# DO NOT commit .env or .env.local.
#
# 詳細セットアップ: docs/api-driven-development/db-setup.md

# === App ===
NEXT_PUBLIC_APP_URL=
NODE_ENV=

# === Supabase: Database (Prisma) ===
# Settings → Database → Connection string
#   - URI (pgbouncer/pooler, port 6543) → DATABASE_URL
#   - Direct connection (port 5432)     → DIRECT_URL
DATABASE_URL=
DIRECT_URL=

# === Supabase: API ===
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# 物理削除workerは人間承認後にだけ `confirmed` を設定する。未設定はdry-run。
ACCOUNT_PHYSICAL_PURGE_APPLY=

# === Auth (Supabase Auth に統合。ローカル開発では基本不要) ===
# Supabase Auth が JWT を発行・検証するため、JWT_SECRET 等の自前管理は不要。
# Apple/Google OAuth プロバイダ設定は Supabase ダッシュボードで行う (ISSUE-006)。

# === Storage (Supabase Storage、ISSUE-008 で使用) ===
# Presigned URL TTL のみクライアントで上書き可能にしておく。
PRESIGNED_URL_TTL_SECONDS=1800

# === AI (ISSUE-010 で使用) ===
ANTHROPIC_API_KEY=
AI_MODEL=
AI_MAX_REGENERATE_PER_DAY=3

# === Observability ===
SENTRY_DSN=
LOG_LEVEL=info

# === Waitlist (公開前 LP) ===
# 待機リストの重複判定用 HMAC pepper。production では必須。
WAITLIST_EMAIL_HASH_PEPPER=
# プロダクトイベントの月次仮名化用 HMAC pepper。32文字以上をSecret Managerで管理する。
PRODUCT_EVENT_HASH_PEPPER=
# ISSUE-186のDB authority・retention検証後に保護Environmentから規定値を設定する。
PRODUCT_EVENT_INGEST_ACTIVATION=
# ISSUE-185の全key version退会purge・HMAC key lifecycle検証後に保護Environmentから規定値を設定する。
PRODUCT_EVENT_PURGE_ACTIVATION=
# GitHub Issue #384のstatus-only degradation ledger検証後に保護Environmentから規定値を設定する。3 activationが揃うまでingestは503で停止する。
PRODUCT_EVENT_DEGRADATION_ACTIVATION=
# Web Vitalsのserver-side sampling用HMAC key。32文字以上をSecret Managerで管理する。
WEB_VITALS_SAMPLING_KEY=
# sampling decisionを期待manifestと結び付けるkey version。`none`は禁止。
WEB_VITALS_SAMPLING_KEY_VERSION=
# ISSUE-187の共有rate limit検証後に保護Environmentからtrueを設定する。
WEB_VITALS_SHARED_RATE_LIMIT_READY=false
# hosting proxyがforwarding headerを除去・上書きすると確認できた環境でだけtrue。
WEB_VITALS_TRUST_PROXY_HEADERS=false
# trusted edgeが付与するattestation secret。32文字以上をSecret Managerで管理する。
WEB_VITALS_EDGE_ATTESTATION_SECRET=
# hosting proxy が forwarding header を除去・上書きすると確認できた環境でだけ true。
WAITLIST_TRUST_PROXY_HEADERS=false
