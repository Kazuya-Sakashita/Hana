{
  "name": "hana",
  "version": "0.0.0",
  "private": true,
  "description": "Hana — AI 育児記録アプリ (写真1枚から AI が記憶を物語にする)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "analyze": "ANALYZE=true pnpm build:ci --webpack",
    "build": "next build",
    "build:ci": "NEXT_FONT_GOOGLE_MOCKED_RESPONSES=$PWD/tests/fixtures/next-font-google-mocked-responses.cjs NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_APP_URL=http://localhost:3000 NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=ci-dummy-anon-key SUPABASE_SERVICE_ROLE_KEY=ci-dummy-service-role-key DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hana_ci DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hana_ci ANTHROPIC_API_KEY=ci-dummy-anthropic-key AI_MODEL=claude-haiku-4-5 pnpm build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:build": "tsx tests/e2e/support/assert-environment.ts && NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=synthetic-anon-key SUPABASE_SERVICE_ROLE_KEY=synthetic-service-role-key ANTHROPIC_API_KEY=synthetic-anthropic-key AI_MODEL=claude-haiku-4-5 pnpm build",
    "e2e": "playwright test",
    "pr:gate": "pnpm format:check && pnpm lint && pnpm issues:check && pnpm openapi:route-map && pnpm openapi:auth-contract && pnpm typecheck && pnpm test && pnpm qa:issue064:design-dom-smoke -- --mode=contract && pnpm qa:issue082:lp-app-visual-parity -- --mode=contract && pnpm qa:issue075:lp-public -- --mode=contract && pnpm qa:issue091:waitlist-readiness -- --mode=contract && pnpm qa:issue103:prelaunch-traffic -- --mode=contract && pnpm qa:issue106:staging-target -- --mode=contract && pnpm qa:issue107:migration-status -- --mode=contract && pnpm qa:issue109:privacy-mailbox -- --mode=contract && pnpm qa:issue110:staging-public -- --mode=contract && pnpm build:ci",
    "issues:write": "node --import tsx scripts/issues/issue-registry.ts write",
    "issues:check": "node --import tsx scripts/issues/issue-registry.ts check",
    "issues:check-github": "node --import tsx scripts/issues/issue-registry.ts check-github",
    "issues:sync-github": "node --import tsx scripts/issues/issue-registry.ts sync-github",
    "qa:issue028:images": "node scripts/qa/issue-028-image-network-check.mjs",
    "qa:issue028:lighthouse-summary": "node scripts/qa/issue-028-lighthouse-summary.mjs",
    "qa:issue059:design-mobile-gate": "node scripts/qa/issue-059-design-mobile-gate.cjs",
    "qa:issue059:record-stopwatch": "node scripts/qa/issue-059-record-stopwatch.cjs",
    "qa:issue064:design-dom-smoke": "node scripts/qa/issue-064-design-dom-smoke.cjs",
    "qa:issue075:lp-public": "node scripts/qa/issue-075-lp-public-qa.cjs",
    "qa:issue091:waitlist-readiness": "node scripts/qa/issue-091-waitlist-readiness-contract.cjs",
    "qa:issue103:prelaunch-traffic": "node scripts/qa/issue-103-prelaunch-traffic-attestation.cjs",
    "qa:issue106:staging-target": "node scripts/qa/issue-106-staging-target-contract.cjs",
    "qa:issue107:migration-status": "node scripts/qa/issue-107-staging-migration-status.cjs",
    "qa:issue109:privacy-mailbox": "node --permission --allow-fs-read=scripts/qa/issue-109-privacy-mailbox-attestation.cjs --allow-fs-read=scripts/qa/issue-103-prelaunch-traffic-attestation.cjs --allow-fs-read=package.json --allow-fs-read=docs/release/prelaunch-waitlist-readiness.md --allow-fs-read=docs/issues/ISSUE-109-privacy-mailbox-attestation.md --allow-fs-read=docs/issues/ISSUE-105-staging-preflight-go-hold.md --allow-fs-read=docs/issues/README.md --allow-fs-read=node_modules scripts/qa/issue-109-privacy-mailbox-attestation.cjs",
    "qa:issue110:staging-public": "node scripts/qa/issue-110-staging-public-qa-strict-runtime.cjs",
    "qa:issue123:db-bootstrap": "node scripts/qa/issue-123-bootstrap-postgres.mjs",
    "qa:issue123:image-boundary-db": "node scripts/qa/issue-123-image-access-concurrency.mjs",
    "qa:issue136:purge-db": "ISSUE_136_PURGE_QA=1 vitest run tests/integration/db/issue-136-account-physical-purge-provider.test.ts",
    "qa:issue138:consent-boundary-db": "node scripts/qa/issue-138-ai-consent-concurrency.mjs",
    "qa:issue139:generation-lifecycle-db": "vitest run tests/integration/db/issue-139-ai-generation-lifecycle-db.test.ts",
    "qa:issue141:storage-db": "ISSUE_141_STORAGE_QA=1 vitest run tests/integration/db/issue-141-unconfirmed-upload-cleanup-storage.test.ts",
    "qa:issue142:variant-repair-db": "ISSUE_142_DATABASE_QA=1 vitest run tests/integration/issue-142-image-variant-repair-db.test.ts",
    "qa:issue142:storage-db": "ISSUE_142_STORAGE_QA=1 vitest run tests/integration/db/issue-142-image-variant-repair-storage.test.ts",
    "qa:issue147:compat-trigger-removal-db": "ISSUE_147_DATABASE_QA=1 vitest run tests/integration/db/issue-139-ai-generation-lifecycle-db.test.ts",
    "qa:issue143:image-races": "node scripts/qa/issue-143-image-races.mjs",
    "qa:issue148:maintenance-workflows": "vitest run tests/unit/workflows/maintenance-schedule-workflows.test.ts",
    "qa:issue151:db-bootstrap": "ISSUE_151_DATABASE_QA=1 node scripts/qa/issue-151-bootstrap-postgres.mjs",
    "qa:issue151:child-rls-db": "ISSUE_151_DATABASE_QA=1 vitest run tests/integration/db/issue-151-child-rls.test.ts",
    "backfill:issue137:images": "tsx scripts/maintenance/issue-137-sanitize-existing-images.ts",
    "qa:issue082:lp-app-visual-parity": "node scripts/qa/issue-082-lp-app-visual-parity-contract.cjs",
    "openapi:lint": "redocly lint docs/openapi/openapi.yaml && spectral lint --ruleset .spectral.yaml docs/openapi/openapi.yaml",
    "openapi:route-map": "node scripts/check-openapi-route-map.mjs",
    "openapi:auth-contract": "node scripts/check-route-auth-contract.mjs",
    "openapi:response-contract": "vitest run tests/integration/v1/children.test.ts tests/integration/v1/health.test.ts tests/integration/v1/account-deletion.test.ts tests/integration/v1/metrics-vitals.test.ts tests/integration/v1/waitlist.test.ts tests/integration/v1/public-openapi-response-contract.test.ts tests/unit/openapi/openapi-response-contract.test.ts",
    "openapi:bundle": "redocly bundle docs/openapi/openapi.yaml -o docs/openapi/openapi.bundled.yaml",
    "openapi:gen": "openapi-typescript docs/openapi/openapi.yaml -o src/lib/api/generated/schema.d.ts",
    "openapi:check-breaking": "oasdiff breaking --fail-on WARN origin/main:docs/openapi/openapi.yaml docs/openapi/openapi.yaml",
    "openapi:all": "pnpm openapi:lint && pnpm openapi:route-map && pnpm openapi:bundle && pnpm openapi:gen",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.30.5",
    "@stoplight/spectral-cli": "^6.16.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "yaml": "^2.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
