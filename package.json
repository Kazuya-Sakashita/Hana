{
  "name": "hana",
  "version": "0.0.0",
  "private": true,
  "description": "Hana — AI 育児記録アプリ (写真1枚から AI が記憶を物語にする)",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ci": "NEXT_FONT_GOOGLE_MOCKED_RESPONSES=$PWD/tests/fixtures/next-font-google-mocked-responses.cjs NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_APP_URL=http://localhost:3000 NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co NEXT_PUBLIC_SUPABASE_ANON_KEY=ci-dummy-anon-key SUPABASE_SERVICE_ROLE_KEY=ci-dummy-service-role-key DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hana_ci DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hana_ci ANTHROPIC_API_KEY=ci-dummy-anthropic-key AI_MODEL=claude-haiku-4-5 pnpm build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pr:gate": "pnpm format:check && pnpm lint && pnpm openapi:route-map && pnpm typecheck && pnpm test && pnpm build:ci",
    "openapi:lint": "redocly lint docs/openapi/openapi.yaml && spectral lint --ruleset .spectral.yaml docs/openapi/openapi.yaml",
    "openapi:route-map": "node scripts/check-openapi-route-map.mjs",
    "openapi:bundle": "redocly bundle docs/openapi/openapi.yaml -o docs/openapi/openapi.bundled.yaml",
    "openapi:gen": "openapi-typescript docs/openapi/openapi.yaml -o src/lib/api/generated/schema.d.ts",
    "openapi:check-breaking": "oasdiff breaking origin/main:docs/openapi/openapi.yaml docs/openapi/openapi.yaml || true",
    "openapi:all": "pnpm openapi:lint && pnpm openapi:route-map && pnpm openapi:bundle && pnpm openapi:gen",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "next": "^16.2.6",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.30.5",
    "@stoplight/spectral-cli": "^6.16.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "yaml": "^2.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
