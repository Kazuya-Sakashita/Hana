// Hana Prisma schema
//
// このファイルは ISSUE-005 で datasource + generator のみで開始する。
// 実テーブル (profiles / children / memories 等) は使うタイミングの Issue で追加する。
//   - profiles:      ISSUE-006 (Supabase Auth 統合)
//   - children:      ISSUE-007 (子どもプロフィール API)
//   - images:        ISSUE-008 (写真アップロード + Supabase Storage)
//   - memories:      ISSUE-009 (記録 API)
//   - ai_generations: ISSUE-010 (AI 文章生成) ← このIssue
//
// マイグレーション運用:
//   ローカル: pnpm db:migrate (= prisma migrate dev)
//   本番:    pnpm db:migrate:deploy
//
// 注意:
//   - DATABASE_URL は pgbouncer 経由 (pooled)
//   - DIRECT_URL は port 5432 (direct) — Prisma Migrate に必須
//   - password を含む URL を log や git に出さないこと

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Hana 固有のユーザープロフィール。
// id は Supabase の auth.users.id に 1:1 で対応する (UUID)。
// auth.users への FK は cross-schema のため Prisma では表現せず、migration SQL に手書きで追加する。
//   ALTER TABLE profiles ADD CONSTRAINT profiles_id_fkey
//     FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE;
model Profile {
  id                  String    @id @db.Uuid
  displayName         String?   @map("display_name")
  aiConsentAt         DateTime? @map("ai_consent_at") @db.Timestamptz
  deletionRequestedAt DateTime? @map("deletion_requested_at") @db.Timestamptz
  accessBlockedAt     DateTime? @map("access_blocked_at") @db.Timestamptz
  purgeAfter          DateTime? @map("purge_after") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  children               Child[]
  images                 Image[]
  uploadReservations     UploadReservation[]
  memories               Memory[]
  aiGenerations          AiGeneration[]
  accountDeletionIntents AccountDeletionIntent[]

  @@map("profiles")
}

model UploadReservation {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  storageKey         String    @unique @map("storage_key")
  candidateKind      String    @default("original") @map("candidate_kind") @db.VarChar(20)
  issuedAt           DateTime  @map("issued_at") @db.Timestamptz
  signedUrlExpiresAt DateTime  @map("signed_url_expires_at") @db.Timestamptz
  cleanupAfter       DateTime  @map("cleanup_after") @db.Timestamptz
  status             String    @default("pending") @db.VarChar(20)
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  claimToken         String?   @map("claim_token") @db.Uuid
  claimedAt          DateTime? @map("claimed_at") @db.Timestamptz
  failureReason      String?   @map("failure_reason") @db.VarChar(40)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, cleanupAfter, nextAttemptAt])
  @@map("upload_reservations")
}

model MaintenanceCursor {
  id          String   @id @db.VarChar(50)
  cursorValue String?  @map("cursor_value") @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("maintenance_cursors")
}

model AccountDeletionIntent {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("account_deletion_intents")
}

model AccountDeletionRequest {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @map("user_id") @db.Uuid
  idempotencyKey         String    @map("idempotency_key") @db.Uuid
  receiptHash            String    @unique @map("receipt_hash") @db.Char(64)
  requestedAt            DateTime  @map("requested_at") @db.Timestamptz
  accessBlockedAt        DateTime  @map("access_blocked_at") @db.Timestamptz
  purgeAfter             DateTime  @map("purge_after") @db.Timestamptz
  authRevocationStatus   String    @default("pending") @map("auth_revocation_status") @db.VarChar(20)
  authRevocationAttempts Int       @default(0) @map("auth_revocation_attempts")
  authRevokedAt          DateTime? @map("auth_revoked_at") @db.Timestamptz
  nextAuthAttemptAt      DateTime  @default(now()) @map("next_auth_attempt_at") @db.Timestamptz
  authClaimedAt          DateTime? @map("auth_claimed_at") @db.Timestamptz
  lastAuthFailureReason  String?   @map("last_auth_failure_reason") @db.VarChar(40)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([authRevocationStatus, nextAuthAttemptAt])
  @@map("account_deletion_requests")
}

// 子どもプロフィール。
// MVP は 1 ユーザー 1 子どもに制限する。論理削除を許す前提で、
// `(user_id) WHERE deleted_at IS NULL` の partial unique index を migration SQL に手書きで追加する
// (Prisma では partial index を schema 上で表現できないため)。
// v1 で複数子ども対応するときに index を外す。詳細は ADR-0008。
model Child {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(50)
  birthdate DateTime  @db.Date
  avatarUrl String?   @map("avatar_url")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories Memory[]

  @@index([userId])
  @@map("children")
}

// 写真メタデータ。実体は Supabase Storage の private bucket `images` に保管する。
// アップロード完了 (POST /v1/uploads/confirm) 時点で 1 行作成。
// memory_id は ISSUE-008 段階では null。ISSUE-009 で memories テーブルとの FK を張る。
//   - storage_key は推測不可能な uploads/{userIdHash}/{yyyymm}/{uuid}.{ext} 形式
//   - 物理ファイルの削除は退会フロー (ISSUE-016) で扱う
model Image {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  memoryId            String?   @map("memory_id") @db.Uuid
  memoryPosition      Int?      @map("memory_position")
  storageKey          String    @unique @map("storage_key")
  contentType         String    @map("content_type")
  width               Int
  height              Int
  fileSize            Int       @map("file_size")
  metadataSanitizedAt DateTime? @map("metadata_sanitized_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  memory Memory? @relation(fields: [memoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([memoryId])
  @@map("images")
}

// 記録 (1 日 1 ページの育児ログ)。
// child_id は children.id への FK、user_id は profiles.id への FK (Cascade)。
// 画像との関係は images.memory_id (nullable) で表現する 1:N。
// 論理削除フラグ deleted_at で「やり直し」をサポート。
model Memory {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  childId        String    @map("child_id") @db.Uuid
  idempotencyKey String?   @map("idempotency_key") @db.Uuid
  title          String    @db.VarChar(100)
  body           String?   @db.Text
  recordedAt     DateTime  @map("recorded_at") @db.Date
  weather        String?   @db.VarChar(20)
  isFavorite     Boolean   @default(false) @map("is_favorite")
  aiGenerated    Boolean   @default(false) @map("ai_generated")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  child  Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  images Image[]

  @@unique([userId, idempotencyKey], map: "memories_user_id_idempotency_key_key")
  @@index([userId, recordedAt(sort: Desc), id(sort: Desc)], map: "memories_user_recorded_desc_idx")
  @@index([childId])
  @@map("memories")
}

// AI 文章生成のログ。プロンプト改善・分析・quota チェックに使う。
// PII を含まないこと:
//   - 生成された title / body 自体は保管せず、本数 (input/output tokens)・モデル名・
//     成否のみ記録する。生成結果はクライアントに返したらサーバ側では捨てる。
//   - 子どもの名前を渡したフラグは boolean のみで、name 自体は保管しない。
// 月次 quota チェックに `(user_id, created_at)` の index を張る。
model AiGeneration {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  childId           String?   @map("child_id") @db.Uuid
  model             String    @db.VarChar(100)
  promptVersion     String    @map("prompt_version") @db.VarChar(20)
  // reserved -> processing -> succeeded | failed | discarded。外部AI通信中の復旧とfencingに使う。
  status            String    @default("succeeded") @db.VarChar(20)
  claimToken        String?   @map("claim_token") @db.Uuid
  leaseExpiresAt    DateTime? @map("lease_expires_at") @db.Timestamptz
  quotaCountedAt    DateTime? @map("quota_counted_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  // 成否・コスト等の集計情報のみ。生成本文は保管しない (PII)。
  succeeded         Boolean   @default(true)
  inputTokens       Int?      @map("input_tokens")
  outputTokens      Int?      @map("output_tokens")
  durationMs        Int?      @map("duration_ms")
  attemptCount      Int       @default(1) @map("attempt_count")
  countsTowardQuota Boolean   @default(false) @map("counts_toward_quota")
  // 型付きallowlistのカテゴリIDと固定outcomeのみ。生成本文・promptは保存しない。
  policyCategoryIds String[]  @default([]) @map("policy_category_ids") @db.VarChar(50)
  policyOutcome     String?   @map("policy_outcome") @db.VarChar(40)
  // 失敗理由 (NG ワード検出 / API エラー / quota 超過 等の集計用 enum-ish)
  errorReason       String?   @map("error_reason") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, quotaCountedAt])
  @@index([status, leaseExpiresAt])
  @@map("ai_generations")
}

// 記録体験の匿名化ファネルイベント。
// actor_hash は認証済み user_id をサーバー側で HMAC-SHA256 に変換した値。
// 記録本文、画像情報、氏名、生年月日、メール、URL、storage_key は保存しない。
model ProductEvent {
  eventId       String   @id @map("event_id") @db.Uuid
  actorHash     String   @map("actor_hash") @db.Char(64)
  flowId        String   @map("flow_id") @db.Uuid
  eventName     String   @map("event_name") @db.VarChar(40)
  elapsedBucket String   @map("elapsed_bucket") @db.VarChar(24)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([actorHash, flowId, eventName])
  @@index([actorHash, createdAt])
  @@index([flowId, createdAt])
  @@index([eventName, createdAt])
  @@index([createdAt])
  @@map("product_events")
}

// 公開前 LP の待機リスト登録。
// メールアドレスは待機リスト登録、β版案内、任意のインタビューやフィードバック協力のお願い、
// 正式リリースのお知らせにだけ使う。
// email_hash は重複判定用の HMAC-SHA256。production では WAITLIST_EMAIL_HASH_PEPPER が必須。
// レスポンスや構造化ログには email / email_hash / id を出さない。
model WaitlistSignup {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @db.VarChar(320)
  emailHash            String   @unique @map("email_hash") @db.Char(64)
  source               String?  @db.VarChar(80)
  privacyPolicyVersion String   @default("prelaunch-2026-07-25") @map("privacy_policy_version") @db.VarChar(40)
  consentAt            DateTime @default(now()) @map("consent_at") @db.Timestamptz
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([createdAt])
  @@map("waitlist_signups")
}
